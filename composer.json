{
    "name": "ernestdefoe/gauntlet",
    "description": "Gauntlet — tournaments for Flarum. Single and double elimination, round robin and Swiss; solo or team entries; sign-ups with caps, check-in and a waitlist; seeding by rating; results reported by both sides, confirmed by staff, disputes handled; a live bracket that reads on a phone; and prediction brackets for real-world playoffs.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "tournament",
        "bracket",
        "esports",
        "league",
        "swiss",
        "round robin",
        "playoff"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/gauntlet",
    "support": {
        "issues": "https://github.com/ernestdefoe/gauntlet/issues",
        "source": "https://github.com/ernestdefoe/gauntlet"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Gauntlet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Gauntlet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Gauntlet",
            "category": "feature",
            "icon": {
                "name": "fas fa-trophy",
                "backgroundColor": "#b45309",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags",
                "fof/badges",
                "fof/gamification",
                "ernestdefoe/social-groups",
                "ernestdefoe/picks"
            ]
        }
    },
    "require-dev": {
        "ernestdefoe/picks": "^2.16",
        "ernestdefoe/social-groups": "^2.6",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "fof/badges": "^2.0",
        "fof/gamification": "^2.0",
        "laravel/pint": "^1.32"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs the bracket engine's unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
